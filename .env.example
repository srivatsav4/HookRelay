# Copy to .env (docker compose reads it automatically). These are DEMO values for local use only.
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=hookrelay-dev-password
POSTGRES_DB=hookrelay
DATABASE_URL=postgresql+asyncpg://hookrelay:hookrelay-dev-password@postgres:5432/hookrelay
REDIS_URL=redis://redis:6379/0

# MUST be >= 16 chars. Generate real ones with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
API_KEY_PEPPER=dev-only-api-key-pepper-change-me-0123456789
CORS_ORIGINS=http://localhost:3000

# Demo login + deterministic demo API key (only its HMAC hash is stored in the DB)
DEMO_USER_EMAIL=demo@hookrelay.local
DEMO_USER_PASSWORD=demo-password
DEMO_API_KEY=hr_demo0001_demo-only-key-0123456789abcdefghijklmnop

# SSRF: the mock receiver lives on a private Docker network, so the demo must allow private destinations.
# NEVER enable this in a real deployment. The SSRF_ATTEMPT experiment always runs in strict mode.
ALLOW_PRIVATE_DESTINATIONS=true
REQUIRE_HTTPS=false

# Delivery / retry (production-style defaults; the Reliability Lab uses its own fast per-endpoint schedule)
RETRY_SCHEDULE=10,30,120,600,3600
RETRY_JITTER=0.2
DELIVERY_TIMEOUT_S=10
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_S=15
WORKER_MAX_JOBS=20
TENANT_MAX_CONCURRENCY=5

# Recovery scanner
RECOVERY_INTERVAL_S=10
RECOVERY_PENDING_GRACE_S=5
VISIBILITY_TIMEOUT_S=60
MOCK_RECEIVER_URL=http://mock-receiver:9000
